# ============ 必填 ============
# DeepSeek 的 key（去 platform.deepseek.com 生成）
DEEPSEEK_API_KEY=

# 和 NapCat 面板里配置的正向 WebSocket token 保持一致，随便设一串
ONEBOT_TOKEN=change-me-please

# ============ 账号 ============
# 机器人小号的 QQ（不填也行，用来做过滤）
SELF_QQ=
# 只允许这个 QQ 跟它聊天。多个用逗号分隔。留空 = 谁都能聊（不建议）
OWNER_QQ=

# ============ 模型 ============
MODEL=deepseek-chat
TEMPERATURE=1.1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 连接 ============
ONEBOT_WS_URL=ws://napcat:3001

# ============ 记忆 ============
# 最近多少条原文进上下文（越大越连贯，也越费 token）
HISTORY_LIMIT=24
HISTORY_TOKENS=1200
# 长期记忆最多注入多少 token
MEMORY_TOKENS=1500
# 攒够多少条消息压缩成一段回忆
EPISODE_THRESHOLD=12
# 每几段回忆做一次人设反思
REFLECT_EVERY=4

# ============ 主动发消息 ============
PROACTIVE=true
# 每天哪几个时段可能主动找你（会在这段时间内随机挑一个时刻）
WAKE_SLOTS=08:30-09:30,12:00-13:00,21:00-23:00
# 每天最多主动发几条
PROACTIVE_DAILY_MAX=3
# 两次主动消息至少隔多少分钟
PROACTIVE_MIN_GAP_MIN=90

# ============ 回复节奏 ============
# 有多大概率秒回（剩下的按字数慢慢打）
FAST_REPLY_CHANCE=0.35
# 允许偶尔不回消息
SKIP_ENABLED=true
# 这些时段算"在忙"，回复会变慢
BUSY_HOURS=9-12,14-17

# ============ 联想续聊 ============
# 回完之后偶尔再补一句，把话题接下去
FOLLOW_UP=true
# 补话概率的倍数，调大更主动
FOLLOW_UP_RATE=1.0

# ============ 作息 ============
# 这段小时不主动发消息（1 到 8 点）
QUIET_START=1
QUIET_END=8
# 深夜回复变慢
NIGHT_SLOWDOWN=true
# 聊着聊着说"我去洗个澡"，然后真的安静十几分钟再回来
AWAY=true
# 一轮聊完之后离开的概率
AWAY_CHANCE=0.12
# 半夜被吵醒只回一句迷糊的就接着睡到早上
SLEEP_NOTE=true
# 被对方一句话带着变心情
MOOD_SHIFT=true
